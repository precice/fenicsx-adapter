<?xml version="1.0" encoding="UTF-8" ?>
<precice-configuration>
  <log>
    <sink
      filter="%Severity% > debug and %Rank% = 0"
      format="---[precice] %ColorizedSeverity% %Message%"
      enabled="true" />
  </log>

  <data:scalar name="LeftIn" waveform-degree="1" />
  <data:scalar name="LeftOut" waveform-degree="1" />
  <data:scalar name="RightIn" waveform-degree="1" />
  <data:scalar name="RightOut" waveform-degree="1" />


  <mesh name="LeftOne" dimensions="2">
    <use-data name="LeftIn" />
    <use-data name="LeftOut" />
  </mesh>

  <mesh name="LeftTwo" dimensions="2">
    <use-data name="RightIn" />
    <use-data name="RightOut" />
  </mesh>

  <mesh name="RightOne" dimensions="2">
    <use-data name="LeftIn" />
    <use-data name="LeftOut" />
  </mesh>

  <mesh name="RightTwo" dimensions="2">
    <use-data name="RightIn" />
    <use-data name="RightOut" />
  </mesh>

  <participant name="Left">
    <provide-mesh name="LeftOne" />
    <receive-mesh name="RightOne" from="Right" />
    <provide-mesh name="LeftTwo" />
    <receive-mesh name="RightTwo" from="Right" />

    <write-data name="LeftOut" mesh="LeftOne" />
    <write-data name="RightIn" mesh="LeftTwo" />

    <read-data name="LeftIn" mesh="LeftOne" />
    <mapping:nearest-neighbor
      direction="read"
      from="RightOne"
      to="LeftOne"
      constraint="consistent" />

    <read-data name="RightOut" mesh="LeftTwo" />
    <mapping:nearest-neighbor
      direction="read"
      from="RightTwo"
      to="LeftTwo"
      constraint="consistent" />
  </participant>

  <participant name="Right">
    <provide-mesh name="RightOne" />
    <receive-mesh name="LeftOne" from="Left" />
    <write-data name="LeftIn" mesh="RightOne" />
    <read-data name="LeftOut" mesh="RightOne" />
    <mapping:nearest-neighbor
      direction="read"
      from="LeftOne"
      to="RightOne"
      constraint="consistent" />
    <provide-mesh name="RightTwo" />
    <receive-mesh name="LeftTwo" from="Left" />
    <write-data name="RightOut" mesh="RightTwo" />
    <read-data name="RightIn" mesh="RightTwo" />
    <mapping:nearest-neighbor
      direction="read"
      from="LeftTwo"
      to="RightTwo"
      constraint="consistent" />
  </participant>

  <m2n:sockets acceptor="Left" connector="Right" exchange-directory=".." />

  <coupling-scheme:serial-implicit>
    <participants first="Left" second="Right" />
    <max-time value="1.0" />
    <time-window-size value="1.0" />
    <max-iterations value="100" />
    <exchange
      data="LeftOut"
      mesh="LeftOne"
      from="Left"
      to="Right"
      initialize="true"
      substeps="true" />
    <exchange
      data="LeftIn"
      mesh="RightOne"
      from="Right"
      to="Left"
      initialize="true"
      substeps="true" />
    <exchange
      data="RightOut"
      mesh="RightTwo"
      from="Right"
      to="Left"
      initialize="true"
      substeps="true" />
    <exchange
      data="RightIn"
      mesh="LeftTwo"
      from="Left"
      to="Right"
      initialize="true"
      substeps="true" />
    <relative-convergence-measure data="LeftOut" mesh="LeftOne" limit="1e-10" />
    <relative-convergence-measure data="RightIn" mesh="LeftTwo" limit="1e-10" />
    <relative-convergence-measure data="LeftIn" mesh="RightOne" limit="1e-10" />
    <relative-convergence-measure data="RightOut" mesh="RightTwo" limit="1e-10" />
    <acceleration:constant>
      <relaxation value="0.5" />
    </acceleration:constant>
  </coupling-scheme:serial-implicit>
</precice-configuration>
