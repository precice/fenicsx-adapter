<?xml version="1.0" encoding="UTF-8" ?>
<precice-configuration>
  <log>
    <sink
      filter="%Severity% > debug and %Rank% = 0"
      format="---[precice] %ColorizedSeverity% %Message%"
      enabled="true" />
  </log>

  <data:scalar name="LeftInOne" waveform-degree="1" />
  <data:scalar name="LeftInTwo" waveform-degree="1" />
  <data:scalar name="LeftOutOne" waveform-degree="1" />
  <data:scalar name="LeftOutTwo" waveform-degree="1" />
  <data:scalar name="LeftOutThree" waveform-degree="1" />

  <mesh name="LeftOne" dimensions="2">
    <use-data name="LeftInOne" />
    <use-data name="LeftOutOne" />
    <use-data name="LeftOutTwo" />
  </mesh>

  <mesh name="LeftTwo" dimensions="2">
    <use-data name="LeftInTwo" />
    <use-data name="LeftOutThree" />
  </mesh>

  <mesh name="RightOne" dimensions="2">
    <use-data name="LeftInOne" />
    <use-data name="LeftOutOne" />
    <use-data name="LeftOutTwo" />
  </mesh>

  <mesh name="RightTwo" dimensions="2">
    <use-data name="LeftInTwo" />
    <use-data name="LeftOutThree" />
  </mesh>

  <participant name="Left">
    <provide-mesh name="LeftOne" />
    <receive-mesh name="RightOne" from="Right" />
    <provide-mesh name="LeftTwo" />
    <receive-mesh name="RightTwo" from="Right" />
    <write-data name="LeftOutOne" mesh="LeftOne" />
    <write-data name="LeftOutTwo" mesh="LeftOne" />
    <read-data name="LeftInOne" mesh="LeftOne" />
    <mapping:nearest-neighbor
      direction="read"
      from="RightOne"
      to="LeftOne"
      constraint="consistent" />
    <write-data name="LeftOutThree" mesh="LeftTwo" />
    <read-data name="LeftInTwo" mesh="LeftTwo" />
    <mapping:nearest-neighbor
      direction="read"
      from="RightTwo"
      to="LeftTwo"
      constraint="consistent" />
  </participant>

  <participant name="Right">
    <provide-mesh name="RightOne" />
    <receive-mesh name="LeftOne" from="Left" />
    <write-data name="LeftInOne" mesh="RightOne" />
    <read-data name="LeftOutOne" mesh="RightOne" />
    <read-data name="LeftOutTwo" mesh="RightOne" />
    <mapping:nearest-neighbor
      direction="read"
      from="LeftOne"
      to="RightOne"
      constraint="consistent" />
    <provide-mesh name="RightTwo" />
    <receive-mesh name="LeftTwo" from="Left" />
    <write-data name="LeftInTwo" mesh="RightTwo" />
    <read-data name="LeftOutThree" mesh="RightTwo" />
    <mapping:nearest-neighbor
      direction="read"
      from="LeftTwo"
      to="RightTwo"
      constraint="consistent" />
  </participant>

  <m2n:sockets acceptor="Left" connector="Right" exchange-directory=".." />

  <coupling-scheme:serial-implicit>
    <participants first="Left" second="Right" />
    <max-time value="1.0" />
    <time-window-size value="1.0" />
    <max-iterations value="100" />
    <exchange
      data="LeftOutOne"
      mesh="LeftOne"
      from="Left"
      to="Right"
      initialize="true"
      substeps="true" />
    <exchange
      data="LeftOutTwo"
      mesh="LeftOne"
      from="Left"
      to="Right"
      initialize="true"
      substeps="true" />
    <exchange
      data="LeftOutThree"
      mesh="LeftTwo"
      from="Left"
      to="Right"
      initialize="true"
      substeps="true" />
    <exchange
      data="LeftInOne"
      mesh="RightOne"
      from="Right"
      to="Left"
      initialize="true"
      substeps="true" />
    <exchange
      data="LeftInTwo"
      mesh="RightTwo"
      from="Right"
      to="Left"
      initialize="true"
      substeps="true" />
    <relative-convergence-measure data="LeftOutOne" mesh="LeftOne" limit="1e-10" />
    <relative-convergence-measure data="LeftOutTwo" mesh="LeftOne" limit="1e-10" />
    <relative-convergence-measure data="LeftOutThree" mesh="LeftTwo" limit="1e-10" />
    <relative-convergence-measure data="LeftInOne" mesh="RightOne" limit="1e-10" />
    <relative-convergence-measure data="LeftInTwo" mesh="RightTwo" limit="1e-10" />
    <acceleration:constant>
      <relaxation value="0.5" />
    </acceleration:constant>
  </coupling-scheme:serial-implicit>
</precice-configuration>
